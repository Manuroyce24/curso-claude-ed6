# Copia este archivo a .env y ajusta los valores. .env no se versiona.

# Obligatorio. Mínimo 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Opcionales (valores por defecto entre paréntesis)
# ACCESS_TOKEN_TTL_SECONDS=900          # vida del access token (15 min)
# REFRESH_TOKEN_TTL_SECONDS=604800      # vida del refresh token (7 días)
# CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202
# AUTH_RATE_LIMIT_MAX=10                # intentos de login/registro por IP y ventana
# AUTH_RATE_LIMIT_WINDOW_MS=900000      # ventana del límite (15 min)
